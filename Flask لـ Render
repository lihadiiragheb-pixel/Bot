# إضافة واجهة Flask لـ Render
from flask import Flask, jsonify

app = Flask(__name__)

@app.route('/')
def home():
    return jsonify({
        'status': 'running',
        'bot': 'Gold Trading Bot',
        'symbol': Config.SYMBOL,
        'timeframe': Config.TIMEFRAME,
        'test_mode': Config.TEST_MODE
    })

@app.route('/health')
def health():
    return jsonify({'status': 'healthy'}), 200

@app.route('/status')
def status():
    return jsonify({
        'last_signal': bot.last_signal if 'bot' in locals() else 'N/A',
        'position': bot.position if 'bot' in locals() else None,
        'running': bot.is_running if 'bot' in locals() else False
    })

# تعديل نقطة الدخول
if __name__ == "__main__":
    import threading
    
    # تشغيل البوت في خيط منفصل
    bot = GoldTradingBot()
    bot_thread = threading.Thread(target=bot.run)
    bot_thread.daemon = True
    bot_thread.start()
    
    # تشغيل خادم Flask
    app.run(host='0.0.0.0', port=Config.PORT)
